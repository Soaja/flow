{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/missing-project.js": { "includeFiles": "dist/_pages/not-found.html" }
  },
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "page", "value": "work" }], "destination": "/_pages/work.html" },
    { "source": "/", "has": [{ "type": "query", "key": "project", "value": "(?<slug>jordan-the-one|nike-midnight-run|metcon-fortfight)" }], "destination": "/_pages/projects/:slug.html" },
    { "source": "/", "has": [{ "type": "query", "key": "project", "value": ".+" }], "destination": "/api/missing-project" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] },
    { "source": "/(.*)\\.(webp|svg|mp4)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }] }
  ]
}
